# Local development only. Change this before using a shared host.
POSTGRES_PASSWORD=talos-local-development
TALOS_PORT=8000
# Explicit local HTTP only; use true for an HTTPS dashboard.
TALOS_ADMIN_COOKIE_SECURE=false
# Frontend development on port 5173 needs an explicit origin as well:
# TALOS_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173"]
# Optional approved native versions. Additional entries must point to installed
# Talos wrapper image IDs/digests; see README's runtime version selection section.
# TALOS_RUNTIME_VERSIONS={"openclaw":{"2026.9.6":"talos-openclaw-native:local"},"hermes":{"0.21.5":"talos-hermes-native:local"}}

# Optional: path only, never the key itself. Used by compose.openrouter.yaml.
# TALOS_OPENROUTER_SECRET_FILE=/absolute/private/path/openrouter.key
